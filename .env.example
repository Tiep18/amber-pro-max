# Hosted scheduled-work setup order:
# 1. Enable Supabase Cron (pg_cron), pg_net, and Vault.
# 2. Store the deployed site URL in Vault as `transactional_email_site_url`.
# 3. Store one long random secret in Vault as
#    `transactional_email_worker_secret` and set the identical value as
#    TRANSACTIONAL_EMAIL_WORKER_SECRET on Vercel.
# 4. Apply migrations, or run `select private.repair_scheduled_jobs();` after
#    enabling/repairing extensions, then verify `/admin/launch`.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase key for provider webhooks, cron, and trusted payment reads.
# Never prefix this with NEXT_PUBLIC_ and never expose it to browser bundles.
SUPABASE_SECRET_KEY=

# Server-only PayPal configuration for international USD orders.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_EXPECTED_MERCHANT_ID=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_ENABLED_COUNTRIES=US
PAYPAL_ENABLED_CURRENCY=USD

# Server-only VietQR receiving-bank configuration for Vietnam VND orders.
VIETQR_BANK_ID=
VIETQR_ACCOUNT_NO=
VIETQR_ACCOUNT_NAME=
VIETQR_TEMPLATE=compact2

# Server-only transactional email configuration. Never put RESEND_API_KEY in
# Vault for the scheduler.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Stable server-only HMAC secret for retry-safe email links. Use at least 32
# random characters and never rotate it while tokenized outbox rows are pending.
TRANSACTIONAL_EMAIL_TOKEN_SECRET=
TRANSACTIONAL_EMAIL_WORKER_SECRET=

# Optional public support channels. These remain server-read and are projected
# to customer UI only after validation; never use NEXT_PUBLIC_ for them.
SUPPORT_EMAIL=
SUPPORT_ZALO_URL=

# Customer-facing date/time formatting only. Stored instants remain unchanged.
STORE_TIME_ZONE=Asia/Ho_Chi_Minh
