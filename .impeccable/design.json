      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Standard customer action; the homepage hero uses a separate brand-brown treatment.",
      "html": "<button class=\"ds-btn-primary\">Continue</button>",
      "css": ".ds-btn-primary{min-height:44px;padding:8px 16px;border:0;border-radius:var(--radius-control,8px);background:var(--accent,#a94734);color:#fff;font:600 16px Nunito,sans-serif;transition:background-color .2s}.ds-btn-primary:hover{background:var(--accent-hover,#873627)}.ds-btn-primary:focus-visible{outline:2px solid var(--accent,#a94734);outline-offset:2px}.ds-btn-primary:disabled{cursor:not-allowed;opacity:.6}"
