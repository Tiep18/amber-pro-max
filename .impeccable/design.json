    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Quiet bordered action beside or below a primary action.",
      "html": "<button class=\"ds-btn-secondary\">View details</button>",
      "css": ".ds-btn-secondary{min-height:44px;padding:8px 16px;border:1px solid var(--border,#ded2c2);border-radius:var(--radius-control,8px);background:var(--surface,#fffaf2);color:var(--foreground,#3b332d);font:600 16px Nunito,sans-serif;transition:background-color .2s}.ds-btn-secondary:hover{background:var(--surface-muted,#ece3d4)}.ds-btn-secondary:focus-visible{outline:2px solid var(--accent,#a94734);outline-offset:2px}"
    },
    {
      "name": "Input",
      "kind": "input",
      "refersTo": "input",
      "description": "Warm form field with an accent focus treatment.",
      "html": "<input class=\"ds-input\" placeholder=\"Email address\" aria-label=\"Email address\">",
      "css": ".ds-input{box-sizing:border-box;min-height:44px;width:100%;padding:8px 12px;border:1px solid var(--border,#ded2c2);border-radius:var(--radius-control,8px);background:var(--surface,#fffaf2);color:var(--foreground,#3b332d);font:400 16px Nunito,sans-serif}.ds-input::placeholder{color:var(--muted-foreground,#786b61)}.ds-input:focus-visible{border-color:var(--accent,#a94734);outline:2px solid color-mix(in srgb,var(--accent,#a94734) 25%,transparent);outline-offset:0}.ds-input:disabled{opacity:.5}"
    },
    {
