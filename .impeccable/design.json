      "kind": "card",
      "refersTo": "card",
      "description": "Flat, bordered content surface for forms and task content.",
      "html": "<section class=\"ds-card\"><h3>Order details</h3><p>Information appears here.</p></section>",
      "css": ".ds-card{padding:24px;border:1px solid var(--border,#ded2c2);border-radius:var(--radius-card,8px);background:var(--surface,#fffaf2);color:var(--foreground,#3b332d);font-family:Nunito,sans-serif}.ds-card h3{margin:0 0 8px;font-size:20px;font-weight:600}.ds-card p{margin:0;color:var(--muted-foreground,#786b61);line-height:1.5}"
    },
    {
      "name": "Product Card",
      "kind": "card",
      "description": "Image-led catalog tile with selective warm lift on hover.",
      "html": "<article class=\"ds-product-card\"><div class=\"ds-product-image\">Crochet product image</div><div class=\"ds-product-body\"><span class=\"ds-product-badge\">Handmade</span><h3>Crochet companion</h3><p>Made with care</p><strong>Price</strong></div></article>",
      "css": ".ds-product-card{overflow:hidden;border:1px solid var(--border,#ded2c2);border-radius:18px;background:var(--surface,#fffaf2);box-shadow:0 18px 55px rgb(73 52 32 / 8%);color:var(--foreground,#3b332d);font-family:Nunito,sans-serif;transition:transform .3s,box-shadow .3s}.ds-product-card:hover{transform:translateY(-4px);box-shadow:0 24px 70px rgb(73 52 32 / 14%)}.ds-product-card:focus-within{outline:2px solid var(--accent,#a94734);outline-offset:2px}.ds-product-image{display:grid;aspect-ratio:5/4;place-items:center;background:var(--surface-muted,#ece3d4);color:var(--muted-foreground,#786b61)}.ds-product-body{display:grid;gap:8px;padding:20px}.ds-product-body h3,.ds-product-body p{margin:0}.ds-product-badge{width:max-content;padding:4px 8px;border-radius:8px;background:var(--surface-blush,#f8ebe5);color:var(--accent,#a94734);font-size:11px;font-weight:600}.ds-product-body strong{padding-top:10px;border-top:1px solid var(--border,#ded2c2);color:var(--brand,#62220c)}"
