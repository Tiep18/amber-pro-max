  "narrative": {
    "northStar": "Cửa hàng thủ công tinh tế",
    "overview": "The storefront feels refined and gentle. Warm cream surfaces and deep clay-brown accents make a quiet frame for the crochet work, which carries the strongest visual detail. The existing homepage uses a studio photograph, a readable cream overlay, and restrained typography to introduce the brand.\n\nThe visual system is mostly flat: paper-like surfaces, fine borders, and generous space establish structure. Soft shadows mark selected interactive or featured elements. Controls remain tidy, easy to use, and light in character. This document records the implemented storefront; the admin interface may use its existing denser, task-focused treatment.",
    "keyCharacteristics": [
      "Cream and clay-brown palette, with product and studio photography as the focal point.",
      "Nunito throughout, from prominent headings to compact labels.",
      "Flat default surfaces; selective soft elevation for emphasis and interaction.",
      "Clear market and language controls without disturbing the shopping content."
    ],
    "rules": [
      {
        "name": "The Cream-and-Clay Rule",
        "body": "Keep the warm cream and clay-brown relationship visible across customer-facing screens; product imagery provides the richer color variation.",
        "section": "colors"
      },
      {
        "name": "The Selective Elevation Rule",
        "body": "A shadow signals emphasis or interaction; ordinary content and form surfaces remain visually quiet.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep crochet photography and product details as the visual focal point.",
      "Do use cream surfaces, clay-brown typography, and terracotta interaction cues consistently.",
      "Do retain clear focus, hover, disabled, and reduced-motion behavior."
    ],
    "donts": [
      "Don't apply heavy shadows to every card or form surface.",
      "Don't replace the warm page canvas with an all-white default.",
      "Don't copy the marketing hero's scale into task-focused checkout or admin screens."
    ]
  }
